# kfzwerk-mvp — environment template. Copy to `.env.local` and fill in.

# The NestJS backend (kfzwerk-mvp-backend). Must include the /api prefix.
VITE_API_URL=http://localhost:3002/api

# AES key for the login/registration form body. MUST match the backend's
# FORM_ENCRYPTION_KEY exactly. Vite inlines VITE_* into the public bundle, so
# this is form obfuscation, not a secret — HTTPS provides confidentiality.
VITE_FORM_ENCRYPTION_KEY=
